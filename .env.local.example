# Copy to .env.local for local development.

# "fixtures" (default) uses the seeded demo/admin-managed content in
# fixtures/*.json. "supabase" switches to the real database once that's
# wired up (CP8/CP9) — not built yet.
DATA_SOURCE=fixtures

# Required for Admin mode (the pencil/trash controls on Resource Hub and
# Creator Hub) to work at all — without this set, admin mode is disabled
# everywhere. Set this in Netlify's environment variables too, or every
# deploy will have admin mode switched off.
ADMIN_PASSWORD=change-me

# Required for creator sign-up/login to work at all (app/api/auth,
# app/api/creator-data) — signs the session cookie so it can't be forged.
# Any long random string works; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this in Netlify's environment variables too — and use the SAME value
# there as locally isn't required, but must stay identical across deploys
# on the same site, or existing sessions get logged out.
AUTH_SECRET=change-me

# Creator profiles and per-creator data (shot lists, hub completions,
# coaching flags) are stored in Netlify Blobs (lib/serverStore.ts) — no
# extra env vars needed on an actual Netlify deploy, it's automatic.
# Running `next dev` locally, Netlify doesn't inject that context, so sign
# up/login will fail locally unless you either:
#   - run `netlify dev` instead of `next dev` (needs `netlify link` once), or
#   - set these two for manual access to the deployed site's blob store:
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=

# Added in CP8:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

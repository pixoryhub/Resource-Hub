# Copy to .env.local for local development.

# "fixtures" (default) uses the seeded demo/admin-managed content in
# fixtures/*.json. "supabase" switches to the real database once that's
# wired up (CP8/CP9) — not built yet.
DATA_SOURCE=fixtures

# Required for Admin mode (the pencil/trash controls on Resource Hub and
# Creator Hub) to work at all — without this set, admin mode is disabled
# everywhere. Set this in Netlify's environment variables too, or every
# deploy will have admin mode switched off.
ADMIN_PASSWORD=change-me

# Added in CP8:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
